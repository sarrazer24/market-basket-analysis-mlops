# ============================================
# LARGE DATA FILES (Do NOT commit to GitHub)
# ============================================

# Raw dataset files (too large for GitHub)
data/raw/
!data/raw/README.md  # Keep README only

# Processed data (can be regenerated)
data/processed/

# Model outputs and artifacts
models/
!models/README.md  # Keep README only

# Output files and visualizations
outputs/

# ============================================
# SPECIFIC LARGE FILE TYPES
# ============================================

# Compressed archives
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Large CSV files (often >100MB)
*.csv
# Except small CSV config files - adjust as needed
!*.config.csv
!*.sample.csv

# Serialized data
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.feather
*.parquet
*.parquet.gz

# Database files
*.db
*.sqlite
*.sqlite3

